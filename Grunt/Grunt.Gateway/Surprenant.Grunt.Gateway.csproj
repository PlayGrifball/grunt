<Project Sdk="Microsoft.NET.Sdk">
  <!-- ASP.NET Core side of the Halo gateway: the generated HaloInfiniteController plus result mapping and response caching.
       The gateway source generator emits the controller because of [assembly: GenerateGatewayController] in GatewayAssembly.cs. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>
    <RootNamespace>Surprenant.Grunt.Gateway</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Grunt/Surprenant.Grunt.csproj" />
    <ProjectReference Include="../Grunt.SourceGenerator/Grunt.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
