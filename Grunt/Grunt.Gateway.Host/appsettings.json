{
  // Default Warning, like GrifballWebApp: without it, framework Information logs (e.g. the health check service's
  // "Health check \"halo_auth\" ... completed" every time a probe hits /health, /health/live or /health/ready)
  // print every few seconds. Surprenant.Grunt and the request summary line are raised back to Information; health
  // probes still log at Verbose (RequestTelemetryExtensions.GetLevel), which this Default already drops.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Surprenant.Grunt": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ClientConfiguration": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUrl": "",
    "Retry": {
      "MaxAttempts": 4,
      "BaseDelay": "00:00:00.500",
      "MaxDelay": "00:00:20",
      "MaxRetryAfter": "00:01:00"
    }
  },
  "Gateway": {
    "ApiKeyHeader": "X-Api-Key",
    "AdminKey": "",
    "AdminKeyHeader": "X-Admin-Key",
    "ApiKeys": [],
    "GlobalQuota": {
      "PermitsPerMinute": 1200,
      "ReservedFraction": 0.25,
      "ReservedPriority": 0
    },
    "Cache": {
      "Enabled": true,
      "ImmutableTtl": "1.00:00:00",
      "MaxCachedBinaryBytes": 2097152
    },
    "Auth": {
      "TokenPath": "tokens.json",
      "RefreshInterval": "00:30:00",
      "InitialDelay": "00:00:05",
      "SignInStateLifetime": "00:15:00",
      "UseInstanceLock": true
    }
  }
}
