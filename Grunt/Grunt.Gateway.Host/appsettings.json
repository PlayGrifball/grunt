{
  // Default Warning, like GrifballWebApp: without it, framework Information logs (e.g. the health check service's
  // "Health check \"halo_auth\" ... completed" every time a probe hits /health, /health/live or /health/ready)
  // print every few seconds. Surprenant.Grunt and the request summary line are raised back to Information; health
  // probes still log at Verbose (RequestTelemetryExtensions.GetLevel), which this Default already drops.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Surprenant.Grunt": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ClientConfiguration": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUrl": "",
    "Retry": {
      "MaxAttempts": 4,
      "BaseDelay": "00:00:00.500",
      "MaxDelay": "00:00:20",
      "MaxRetryAfter": "00:01:00"
    },
    // What one account may take from each Halo service (HaloBudgets), from Halo's limits as measured on 2026-11-15
    // (GATEWAY.md, "Halo's limits"). A call over budget waits up to MaxWait for room, then gets a 429 with the time
    // until there is room, never sent to Halo; a 429 from Halo locks the budget for Lockout.
    "Budgets": {
      // Gamertags and users share one count: about 20 a minute (20 to 30 in tests), then every call answered 429 for
      // about 5 minutes, with no Retry-After. 15 leaves room; no waiting, a minute's wait rarely helps.
      "profile": {
        "Operations": [ "UserByGamertag", "Users" ],
        "Limit": 15,
        "Window": "00:01:00",
        "Lockout": "00:05:00",
        "MaxWait": "00:00:00"
      },
      // 2 to 3 a second answered, the rest 429 with Retry-After: 1, then answered again at once: a call waits up to
      // 2 seconds for room.
      "matchHistory": {
        "Operations": [ "StatsGetMatchHistory" ],
        "Limit": 2,
        "Window": "00:00:01",
        "Lockout": "00:00:01",
        "MaxWait": "00:00:02"
      },
      // Never answered 429 up to 480 a minute (the most the tests sent): that, not Halo's ceiling, which is unknown.
      "matchStats": {
        "Operations": [ "StatsGetMatchStats" ],
        "Limit": 480,
        "Window": "00:01:00",
        "Lockout": "00:00:30",
        "MaxWait": "00:00:02"
      },
      // Player armor and customization reads: not measured yet, so a ceiling well under the 480 a minute matchStats took
      // that bounds what an API key can spend on the shared account; replace it with Halo's real limit once measured.
      "customization": {
        "Operations": [ "EconomyPlayerPublicCustomization", "EconomyPlayerAppearanceCustomization", "EconomyPlayerCustomization", "EconomyGetMultiplePlayersCustomization", "EconomyArmorCoresCustomization", "EconomyArmorCoreCustomization", "GameCmsGetCustomizationCatalog", "GameCmsGetItem", "GameCmsGetEmblemMapping", "GameCmsWaypointGetImage" ],
        "Limit": 120,
        "Window": "00:01:00",
        "Lockout": "00:00:30",
        "MaxWait": "00:00:02"
      }
    }
  },
  "Gateway": {
    "ApiKeyHeader": "X-Api-Key",
    "AdminKey": "",
    "AdminKeyHeader": "X-Admin-Key",
    "ApiKeys": [],
    "Cache": {
      "Enabled": true,
      "ImmutableTtl": "1.00:00:00",
      "MaxCachedBinaryBytes": 2097152
    },
    "Auth": {
      "TokenPath": "tokens.json",
      "RefreshInterval": "00:30:00",
      "InitialDelay": "00:00:05",
      "SignInStateLifetime": "00:15:00",
      "UseInstanceLock": true
    }
  }
}
