<Project Sdk="Microsoft.NET.Sdk">
  <!-- IHaloInfiniteClient over the Halo gateway's HTTP API. HaloGatewayClient is emitted by the gateway source generator because of
       [assembly: GenerateGatewayClient] in GatewayClientAssembly.cs. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Surprenant.Grunt.Gateway.Client</RootNamespace>
    <PackageId>Surprenant.Grunt.Gateway.Client</PackageId>
    <Version>0.0.0.1-beta</Version>
    <Authors>Noah Surprenant</Authors>
    <Description>IHaloInfiniteClient implementation that calls a Grunt Halo gateway over HTTP instead of the Halo Infinite API directly.</Description>
    <Copyright>Copyright for portions of Grunt are held by Den Delimarsky (OpenSpartan Grunt), 2022. All other copyright for Grunt are held by Noah Surprenant, 2024.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PlayGrifball/grunt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PlayGrifball/grunt</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>grunt-logo.png</PackageIcon>
    <PackageTags>halo,halo-api,api,halo-infinite,gateway</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\media\grunt-logo.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Grunt/Surprenant.Grunt.csproj" />
    <ProjectReference Include="../Grunt.SourceGenerator/Grunt.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
